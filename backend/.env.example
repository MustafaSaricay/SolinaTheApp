# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Plain PostgreSQL:
DATABASE_URL=postgresql://solina:solina@localhost:5432/solina

# TimescaleDB (same connection string — just point at a TimescaleDB instance):
# DATABASE_URL=postgresql://solina:solina@localhost:5432/solina

# ── Monitoring ────────────────────────────────────────────────────────────────
# How often to poll battery data (seconds). Default: 300
POLL_INTERVAL_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  '*' allows all.
CORS_ORIGIN=*
